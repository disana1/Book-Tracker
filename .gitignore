import tkinter as tk
from tkinter import messagebox, ttk
import json
import os

class BookTracker:
    def __init__(self, root):
        self.root = root
        self.root.title("Book Tracker")
        self.root.geometry("700x500")
        
        self.books = []
        self.file_path = "books.json"
        
        self.setup_ui()
        self.load_data()

    def setup_ui(self):
        # Поля ввода
        frame_input = tk.Frame(self.root, padx=10, pady=10)
        frame_input.pack(fill="x")

        tk.Label(frame_input, text="Название:").grid(row=0, column=0)
        self.ent_title = tk.Entry(frame_input)
        self.ent_title.grid(row=0, column=1, padx=5)

        tk.Label(frame_input, text="Автор:").grid(row=0, column=2)
        self.ent_author = tk.Entry(frame_input)
        self.ent_author.grid(row=0, column=3, padx=5)

        tk.Label(frame_input, text="Жанр:").grid(row=1, column=0)
        self.ent_genre = tk.Entry(frame_input)
        self.ent_genre.grid(row=1, column=1, padx=5)

        tk.Label(frame_input, text="Страниц:").grid(row=1, column=2)
        self.ent_pages = tk.Entry(frame_input)
        self.ent_pages.grid(row=1, column=3, padx=5)

        btn_add = tk.Button(frame_input, text="Добавить книгу", command=self.add_book, bg="green", fg="white")
        btn_add.grid(row=0, column=4, rowspan=2, padx=10)

        # Фильтры
        frame_filter = tk.Frame(self.root, padx=10, pady=5)
        frame_filter.pack(fill="x")

        tk.Label(frame_filter, text="Фильтр Жанр:").pack(side="left")
        self.filter_genre = tk.Entry(frame_filter, width=10)
        self.filter_genre.pack(side="left", padx=5)

        btn_filter_gen = tk.Button(frame_filter, text="Ок", command=self.apply_filter)
        btn_filter_gen.pack(side="left", padx=5)

        tk.Label(frame_filter, text="Страниц >").pack(side="left", padx=10)
        self.filter_pages = tk.Entry(frame_filter, width=5)
        self.filter_pages.pack(side="left")
        
        btn_filter_pg = tk.Button(frame_filter, text="Ок", command=self.apply_filter)
        btn_filter_pg.pack(side="left", padx=5)

        btn_reset = tk.Button(frame_filter, text="Сброс", command=self.refresh_table)
        btn_reset.pack(side="left", padx=20)

        # Таблица
        self.tree = ttk.Treeview(self.root, columns=("Title", "Author", "Genre", "Pages"), show='headings')
        self.tree.heading("Title", text="Название")
        self.tree.heading("Author", text="Автор")
        self.tree.heading("Genre", text="Жанр")
        self.tree.heading("Pages", text="Страниц")
        self.tree.pack(expand=True, fill="both", padx=10, pady=10)

    def add_book(self):
        title = self.ent_title.get().strip()
        author = self.ent_author.get().strip()
        genre = self.ent_genre.get().strip()
        pages = self.ent_pages.get().strip()

        if not (title and author and genre and pages):
            messagebox.showerror("Ошибка", "Все поля должны быть заполнены!")
            return

        if not pages.isdigit():
            messagebox.showerror("Ошибка", "Количество страниц должно быть числом!")
            return

        book = {"title": title, "author": author, "genre": genre, "pages": int(pages)}
        self.books.append(book)
        self.save_data()
        self.refresh_table()
        
        # Очистка полей
        for entry in [self.ent_title, self.ent_author, self.ent_genre, self.ent_pages]:
            entry.delete(0, tk.END)

    def apply_filter(self):
        genre_val = self.filter_genre.get().lower()
        pages_val = self.filter_pages.get()

        filtered = self.books
        if genre_val:
            filtered = [b for b in filtered if genre_val in b['genre'].lower()]
        if pages_val.isdigit():
            filtered = [b for b in filtered if b['pages'] > int(pages_val)]
        
        self.refresh_table(filtered)

    def refresh_table(self, data=None):
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        display_data = data if data is not None else self.books
        for b in display_data:
            self.tree.insert("", "end", values=(b['title'], b['author'], b['genre'], b['pages']))

    def save_data(self):
        with open(self.file_path, "w", encoding="utf-8") as f:
            json.dump(self.books, f, ensure_ascii=False, indent=4)

    def load_data(self):
        if os.path.exists(self.file_path):
            with open(self.file_path, "r", encoding="utf-8") as f:
                self.books = json.load(f)
            self.refresh_table()

if __name__ == "__main__":
    root = tk.Tk()
    app = BookTracker(root)
    root.mainloop()
